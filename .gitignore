# Dependencies and build output
node_modules/
dist/

# A packaged core produced by an older layout. `scripts/package.mjs` now writes to
# artifacts/p0-<id>/core and `deploy-plugin.mjs` reads it from there; the copy at
# the repository root was left behind by the Electron-era build, had drifted from
# src/ while still being committed. It is a build output, never a source tree.
core/

# Standalone console builds. The installer and portable exe this produces are
# release assets, not source.
dist-console-out/
dist-console/
dist-console-build/

# A pre-extracted Electron tree, used via `electronDist` in electron-builder.yml
# so the build does not have to unpack and rename the cached archive itself.
electron-dist/

# Generated local artifacts: packaged bundles, extracted runtimes, test workspaces
artifacts/
.local/

# Rollback copies written by scripts/deploy-plugin.mjs, and the deploy target a
# test run may create inside this tree. Each backup is a full copy of a deployed
# tree, so they must never be committed: 92 of them once added up to ~1.58 GB of
# files that were never meant to ship. The deploy script now keeps only the
# newest few per target; this rule covers whatever a past run left behind.
*.backup-*
.amb-deploy-test-target-*/

# Verification run output. The scripts and their JSON results are kept (they are
# reproducible evidence), but the raw console logs record absolute paths from the
# machine that ran them and the harness writes them fresh on every run.
verification/**/evidence/
verification/**/*.log

# Runtime state and credentials: never commit these
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.token
core.json
client.json
*-client.json
.env
.env.*
!.env.example

# Host-side plugin installs a test run may create in this tree
.agents/plugins/marketplace.json
.codex/config.toml
.codex/backups/

# Development process traces: session handoffs, agent reviews, dialogue dumps.
# Kept locally for continuity, deliberately excluded from the published surface.
docs/internal/
docs/diagnostics/
docs/handoffs/
tmp-*

# Acceptance report: regenerated by `npm run accept:desktop` on every run, so it
# carries a fresh timestamp and local paths. The documented command is what ships.
docs/implementation/desktop-acceptance-report.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
__pycache__/
*.pyc

# Internal planning records: the collaboration process behind the plan, not the
# product documentation. Kept locally; excluded from the published surface.
docs/plans/

# Environment-detection cache written by the zerotoken skill; machine-specific.
.zerotoken/

# Export artefacts and their archives are user data, not source.
*.ambpack
*.tgz
console.archived-electron/node_modules/