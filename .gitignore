# Dependencies and build output
node_modules/
dist/

# Generated local artifacts: packaged bundles, extracted runtimes, test workspaces
artifacts/
.local/

# Runtime state and credentials: never commit these
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.token
core.json
client.json
*-client.json
.env
.env.*
!.env.example

# Host-side plugin installs a test run may create in this tree
.agents/plugins/marketplace.json
.codex/config.toml
.codex/backups/

# Development process traces: session handoffs, agent reviews, dialogue dumps.
# Kept locally for continuity, deliberately excluded from the published surface.
docs/internal/
tmp-*

# Acceptance report: regenerated by `npm run accept:desktop` on every run, so it
# carries a fresh timestamp and local paths. The documented command is what ships.
docs/implementation/desktop-acceptance-report.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Internal planning records: the collaboration process behind the plan, not the
# product documentation. Kept locally; excluded from the published surface.
docs/plans/

# Environment-detection cache written by the zerotoken skill; machine-specific.
.zerotoken/
